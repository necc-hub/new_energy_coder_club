# 文本文件统一 LF，避免 Windows/Unix 交叉污染
* text=auto eol=lf

*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Windows 专用脚本保留 CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做换行转换
*.exe   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
